# Create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Where alerts are posted (recommended: your Telegram channel)
# 1. Create channel → add this bot as admin with "Post messages"
# 2. Post once in the channel, then run: python get_chat_id.py
# Public channel: @your_channel_username   Private: numeric id (often -100…)
TELEGRAM_CHAT_ID=@your_channel_username

# How often to check Workana (seconds). 60–120 is a good balance for speed vs. load.
POLL_INTERVAL_SECONDS=90

# Workana listing URL (customize filters in the browser, then paste the full URL here)
WORKANA_JOBS_URL=https://www.workana.com/en/jobs?order=recent&language=xx

# Optional: comma-separated keywords — job must match at least one (case-insensitive)
# Leave empty to alert on all new jobs from the URL above
KEYWORDS=

# Optional: max proposals (0 = only jobs with zero bids). Leave empty to ignore.
MAX_BIDS=
